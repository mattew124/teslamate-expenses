# Copy to .env (gitignored) and fill in. Never commit .env.

# Database — the TeslaMate Postgres, with the same values TeslaMate and its other
# add-ons use (TM_DB_NAME, TM_DB_USER, TM_DB_PASS). The app creates its own `expenses`
# schema on start; there is no setup script.
DATABASE_NAME=teslamate
DATABASE_USER=teslamate
DATABASE_PASS=
# Only for a least-privilege role made with scripts/provision-db.sh: set to 1 so the app
# doesn't try to create the schema itself.
#SKIP_MIGRATE=1

# TeslaMate's own FQDN_TM, the same value. The app uses it once, on first start, to pre-fill the
# URLs on its Settings page; docker-compose.traefik.yml also publishes the UI on it.
FQDN_TM=teslamate.example.com

# Only needed with docker-compose.traefik.yml
#AUTH_MIDDLEWARE=authentik-forwardauth@docker
#PROXY_NETWORK=proxy
#PROXY_ENTRYPOINT=websecure

# Optional
#BASE_PATH=/expenses
# Your IANA timezone. Expense dates are entered in it, and it is the dashboard's timezone.
#APP_TZ=UTC
# debug, info, warning or error (default info). Read at start, so restart to change it.
#LOG_LEVEL=info
# 0 stops the app asking api.github.com whether a newer release exists (the footer then shows only
# the version). Released images ask at most every few hours; local builds never do.
#UPDATE_CHECK=1
# 0 stops the app fetching the OneDrive and Grafana logos from cdn.jsdelivr.net (plain drawings are shown instead).
#PROVIDER_ICONS=1
# Where the app writes its Grafana dashboard on start, for Grafana to provision (docs, Setup).
# Leave unset to use /dashboards (the volume docker-compose.yml mounts there); set it empty to
# switch the export off and import grafana/cost-of-ownership.json by hand instead.
#DASHBOARD_DIR=/dashboards
#HOST_PORT=8088
# Turns on OneDrive invoice uploads (docs, "OneDrive uploads"). It encrypts the saved Microsoft
# sign-in before it goes into the database, so keep it out of database backups. Generate one with:
#   openssl rand -base64 32 | tr '+/' '-_'
# Losing or changing it only means pressing Connect OneDrive again.
#EXPENSES_ENCRYPTION_KEY=
# Keeps invoice PDFs in a folder on this server, shown by the app itself (docs, "Invoice folder on the
# server"). Only with docker-compose.invoices.yml, which mounts this folder at /invoices and sets the
# app's INVOICES_DIR to it. Usually a NAS share mounted on this server (an /etc/fstab line with
# x-systemd.automount and nofail, so it is mounted before Docker uses it). The folder must exist; the app
# never creates it. Choosing a car's folder leaves a hidden .teslamate-expenses file at its top: keep it.
# Without it, while a car uses the folder, the app takes it for a share that didn't mount and writes nothing.
#INVOICES_HOST_DIR=/mnt/nas/cars/invoices
# The user and group the app runs as, and so writes invoices as (default 10001:10001). Must be able to
# write INVOICES_HOST_DIR: for an SMB share, the uid= and gid= it is mounted with, e.g. 1000 for a share
# mounted with uid=1000,gid=1000.
#EXPENSES_UID=10001
#EXPENSES_GID=10001
# With docker-compose.invoices.yml: 1 (the default there) stops the app when the invoice folder can't be
# used, a share that didn't mount for example. It logs why (docker compose logs expenses) and exits, and the
# restart policy starts it again until the share is there; if the folder goes away while it runs, the
# container turns unhealthy. 0 keeps it running without the folder: expenses can still be entered.
#INVOICES_REQUIRED=1
#TESLAMATE_NETWORK=teslamate_default
# Where Grafana is under FQDN_TM, for the first-start Dashboards link (default /grafana)
#GRAFANA_PATH=/grafana
# The app stops on start if TeslaMate's database is newer than the TeslaMate it was tested with
# (docs, Setup). 1 runs anyway, logging an error each start. Not advised: TeslaMate's tables change without notice.
#ALLOW_UNTESTED_TESLAMATE=
