# Copy to .env (gitignored) and fill in. Never commit .env.

# Database — the TeslaMate Postgres. DATABASE_NAME is TeslaMate's TM_DB_NAME.
DATABASE_NAME=teslamate
DATABASE_USER=expenses_app
# Generate:  openssl rand -hex 24   (same value goes to scripts/provision-db.sh)
DATABASE_PASS=

# Only needed with docker-compose.traefik.yml
#PUBLIC_HOST=teslamate.example.com
#AUTH_MIDDLEWARE=authentik-forwardauth@docker
#PROXY_NETWORK=proxy
#PROXY_ENTRYPOINT=websecure

# Optional
#BASE_PATH=/expenses
#APP_TZ=UTC
#HOST_PORT=8088
#TESLAMATE_NETWORK=teslamate_default
