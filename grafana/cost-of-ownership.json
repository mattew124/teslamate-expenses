    {
      "id": 1,
      "type": "stat",
      "title": "Total cost",
      "description": "Purchase + running expenses + charging. All-time (ignores the dashboard time range). Follows the Category filter.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
