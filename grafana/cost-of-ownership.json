          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ((SELECT COALESCE(SUM(e.amount), 0) FROM expenses.expense e JOIN expenses.category c ON c.id = e.category_id WHERE e.car_id = $car_id AND c.kind = 'running' AND c.name IN ($category)) + (SELECT CASE WHEN 'Charging' IN ($category) THEN charging_total ELSE 0 END FROM expenses.ownership WHERE car_id = $car_id)) / GREATEST(EXTRACT(EPOCH FROM now() - (SELECT owned_since FROM expenses.ownership WHERE car_id = $car_id)) / 86400, 1)",
          "refId": "A"
        }
      ]
