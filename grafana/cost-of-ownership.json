          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH m AS (\n  SELECT date_trunc('month', e.occurred_at AT TIME ZONE '$tz') AS t, SUM(e.amount) AS a\n  FROM expenses.expense e WHERE e.car_id = $car_id GROUP BY 1\n  UNION ALL\n  SELECT date_trunc('month', (cp.start_date AT TIME ZONE 'UTC') AT TIME ZONE '$tz'), SUM(cp.cost)\n  FROM charging_processes cp WHERE cp.car_id = $car_id GROUP BY 1\n)\nSELECT t AS time, SUM(SUM(a)) OVER (ORDER BY t) AS \"Cumulative cost\"\nFROM m WHERE a IS NOT NULL GROUP BY t ORDER BY t",
          "refId": "A"
        }
      ]
    },
