          "rawSql": "SELECT CASE WHEN y > 0 THEN y || CASE WHEN y = 1 THEN ' year' ELSE ' years' END || CASE WHEN m > 0 THEN ', ' || m || CASE WHEN m = 1 THEN ' month' ELSE ' months' END ELSE '' END ELSE m || CASE WHEN m = 1 THEN ' month' ELSE ' months' END END FROM (SELECT EXTRACT(YEAR FROM a)::int AS y, EXTRACT(MONTH FROM a)::int AS m FROM (SELECT age(now(), owned_since) AS a FROM expenses.ownership WHERE car_id = $car_id) x) t",
