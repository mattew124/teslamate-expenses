        "includeAll": true,
        "multi": true,
        "options": [],
        "regex": "",
        "query": "SELECT name FROM (SELECT name, sort_order AS s FROM expenses.category UNION ALL SELECT 'Charging', 1000) x ORDER BY s, name",
        "definition": "SELECT name FROM (SELECT name, sort_order AS s FROM expenses.category UNION ALL SELECT 'Charging', 1000) x ORDER BY s, name",
