# Copy to dev.env (gitignored). All optional: with nothing set, the dev stack
# listens on localhost only, and seeds from teslamate-database-1.

#APP_TZ=Australia/Brisbane          # also the dashboard's default timezone
#SEED_FROM=teslamate-database-1     # your TeslaMate database container
#DEV_UI_PORT=8089
#DEV_GRAFANA_PORT=8090

# Publish through Traefik instead of localhost. The app has no login of its own,
# so AUTH_MIDDLEWARE (a forward-auth middleware) is required with PUBLIC_HOST.
#PUBLIC_HOST=teslamate.example.com
#AUTH_MIDDLEWARE=authentik-forwardauth@docker
#PROXY_NETWORK=proxy
#PROXY_ENTRYPOINT=websecure

# Keep CLAUDE.local.md (local notes for Claude Code) as a copy of a file kept
# elsewhere, e.g. in a private repo. Refreshed by every dev.sh command.
#CLAUDE_LOCAL_SOURCE=/path/to/private/notes.md

# Where scripts/dev.sh onedrive-save keeps the saved dev OneDrive sign-in. Must be outside
# the repository. Default: ~/.config/teslamate-expenses/onedrive-dev
#ONEDRIVE_DEV_FILE=/path/outside/the/repo/onedrive-dev

# The dev stack's invoice folder. Default: .dev/invoices in the checkout. Point it at a mounted NAS
# share to try the app on one; it must already be there and be writable by you (the app runs as you).
#DEV_INVOICES_DIR=/mnt/nas/expenses-test
